<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.netcommerce</groupId>
        <artifactId>netcommerce</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>api</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>kernel-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>kernel-compliance</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>kernel-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>kernel-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>kernel-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>basket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>media</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>shipping</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>ordering</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>payments</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netcommerce</groupId>
            <artifactId>finance</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
